{
  ".platform-win32 atom-workspace, .platform-linux atom-workspace": {
    "ctrl-t": "tranquil-browser:open",
    "ctrl-shift-a": "tranquil-browser:add-to-tree-view",
    "ctrl-s": "tranquil-browser:save-url",
    "ctrl-f": "tranquil-browser:find"
  },
  ".platform-darwin atom-workspace": {
    "cmd-t": "tranquil-browser:open",
    "cmd-shift-a": "tranquil-browser:add-to-tree-view",
    "cmd-l": "tranquil-browser:focus-url",
    "cmd-s": "tranquil-browser:save-url",
    "cmd-f": "tranquil-browser:find"
  },
  ".platform-darwin .tranquil-browser": {
    "cmd-l": "tranquil-browser:focus-url",
    "cmd-r": "tranquil-browser:refresh",
    "cmd-shift-r": "tranquil-browser:hard-refresh"
  },
  ".platform-win32 .tranquil-browser, .platform-linux .tranquil-browser": {
    "ctrl-l": "tranquil-browser:focus-url",
    "ctrl-r": "tranquil-browser:refresh",
    "ctrl-shift-r": "tranquil-browser:hard-refresh"
  },
  ".platform-darwin .tranquil-browser-find": {
    "cmd-g": "tranquil-browser:find-next",
    "cmd-shift-g": "tranquil-browser:find-previous"
  },
  ".platform-win32 .tranquil-browser-find, .platform-linux .tranquil-browser-find": {
    "ctrl-g": "tranquil-browser:find-next",
    "ctrl-shift-g": "tranquil-browser:find-previous"
  },
  ".browser-cross webview": {
    "tab": "native!",
    "shift-tab": "native!",
    "click": "native!",
    "pagedown": "native!",
    "pageup": "native!"
  }
}
